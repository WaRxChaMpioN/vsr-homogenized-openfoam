localCode
#{
    // Weight of the rays leaving a face (outward normal nf) in this region's fvDOM:
    // c = sum_{(-n.d) > 0} (-n.dAve)/pi. 1 if the region has no fvDOM (not expected).
    static tmp<scalarField> radiativeInterfaceT_cOut
    (
        const objectRegistry& obr,
        const vectorField& nf
    )
    {
        tmp<scalarField> tc(new scalarField(nf.size(), scalar(1)));
        const radiation::fvDOM* domPtr =
            obr.cfindObject<radiation::fvDOM>("radiationProperties");

        if (domPtr)
        {
            scalarField& c = tc.ref();
            c = Zero;
            for (label rayi = 0; rayi < domPtr->nRay(); ++rayi)
            {
                const vector& d = domPtr->IRay(rayi).d();
                const vector& dAve = domPtr->IRay(rayi).dAve();
                forAll(nf, facei)
                {
                    if ((-nf[facei] & d) > 0)
                    {
                        c[facei] -= (nf[facei] & dAve);
                    }
                }
            }
            c /= constant::mathematical::pi;
        }
        return tc;
    }

    // Incident flux qin of a region on one patch (0 before fvDOM has registered it)
    static tmp<scalarField> radiativeInterfaceT_qin
    (
        const objectRegistry& obr,
        const fvPatch& pp
    )
    {
        const volScalarField* qinPtr = obr.cfindObject<volScalarField>("qin");
        if (qinPtr)
        {
            return tmp<scalarField>
            (
                new scalarField(qinPtr->boundaryField()[pp.index()])
            );
        }
        return tmp<scalarField>(new scalarField(pp.size(), Zero));
    }
#};

code
#{
    const scalar sigma = constant::physicoChemical::sigma.value();

    // Runs inside initEvaluate/evaluate: processor comms may be under way.
    // Shift the tag as greyDiffusiveRadiation and turbulentTemperatureRadCoupledMixed do.
    const int oldTag = UPstream::msgType();
    UPstream::msgType() = oldTag + 1;

    const fvPatch& p = this->patch();
    const label patchi = p.index();
    const fvMesh& mesh = this->internalField().mesh();

    // ---- this side
    const basicThermo& thermo =
        mesh.lookupObject<basicThermo>(basicThermo::dictName);
    const scalarField k1(thermo.kappa(patchi)*p.deltaCoeffs());
    const scalarField Tc1(this->patchInternalField());
    const scalarField qin1(radiativeInterfaceT_qin(mesh, p));
    const scalarField c1(radiativeInterfaceT_cOut(mesh, p.nf()()));
    const scalarField eps1
    (
        radiation::boundaryRadiationProperties::New(mesh).emissivity(patchi)
    );

    // ---- other side, evaluated in its own region and face order ...
    const mappedPatchBase& mpp = refCast<const mappedPatchBase>(p.patch());
    const fvMesh& nbrMesh = refCast<const fvMesh>(mpp.sampleMesh());
    const label nbrPatchi = mpp.samplePolyPatch().index();
    const fvPatch& nbrPatch = nbrMesh.boundary()[nbrPatchi];

    const basicThermo& nbrThermo =
        nbrMesh.lookupObject<basicThermo>(basicThermo::dictName);
    scalarField k2(nbrThermo.kappa(nbrPatchi)*nbrPatch.deltaCoeffs());
    scalarField Tc2(nbrThermo.T().boundaryField()[nbrPatchi].patchInternalField());
    scalarField qin2(radiativeInterfaceT_qin(nbrMesh, nbrPatch));
    scalarField c2(radiativeInterfaceT_cOut(nbrMesh, nbrPatch.nf()()));
    scalarField eps2
    (
        radiation::boundaryRadiationProperties::New(nbrMesh).emissivity(nbrPatchi)
    );

    // ... then mapped onto this patch. Collective: every processor makes these calls,
    // in the same order, also where the patch has no faces.
    mpp.distribute(k2);
    mpp.distribute(Tc2);
    mpp.distribute(qin2);
    mpp.distribute(c2);
    mpp.distribute(eps2);

    UPstream::msgType() = oldTag;

    scalarField& rv = this->refValue();
    scalarField& vf = this->valueFraction();

    forAll(Tc1, facei)
    {
        const scalar ka = k1[facei];
        const scalar kb = k2[facei];
        const scalar K = ka + kb;

        // net radiation absorbed by the face, as greyDiffusive books qr on each side
        const scalar Qabs =
            (1 - c1[facei]*(1 - eps1[facei]))*max(qin1[facei], scalar(0))
          + (1 - c2[facei]*(1 - eps2[facei]))*max(qin2[facei], scalar(0));
        const scalar E = (c1[facei]*eps1[facei] + c2[facei]*eps2[facei])*sigma;
        const scalar C = ka*Tc1[facei] + kb*Tc2[facei] + Qabs;

        // f(T) = C - K T - E T^4 = 0: Newton from an upper bound, monotone
        scalar T = min(C/K, sqrt(sqrt(C/E)));
        for (label iter = 0; iter < 50; ++iter)
        {
            const scalar dT = (C - K*T - E*pow4(T))/(-K - 4*E*pow3(T));
            T -= dT;
            if (mag(dT) < 1e-10*T)
            {
                break;
            }
        }

        // tangent of the balance at T*, this side's cell implicit
        const scalar a = kb + 4*E*pow3(T);
        const scalar b = kb*Tc2[facei] + Qabs + 3*E*pow4(T);

        rv[facei] = b/a;
        vf[facei] = a/(a + ka);
    }

    this->refGrad() = Zero;
#};

