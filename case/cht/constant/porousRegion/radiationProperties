FoamFile { version 2.0; format ascii; class dictionary; object radiationProperties; }
#include "$FOAM_CASE/system/caseParameters"
// Absorbing-emitting grey medium, NO scattering (paper 2 Eqs. qr, rte; Table 2).
// v2206 fvDOM emits with the ABSORPTION coefficient in both the RTE and the energy sink
// (fvDOM.C:578, 664, 725; absorptionEmissionModel.C:240-248): Sh = a G - 4 a sigma T^4.
// 'emissivity' is not read by fvDOM; it is set equal to the absorptivity for clarity.
radiation       on;
radiationModel  fvDOM;
fvDOMCoeffs
{
    nPhi        $nPhi;       // identical in all regions (beam ray and c weights)
    nTheta      $nTheta;
    tolerance   1e-3;
    maxIter     1;
}
solverFreq      $radFreq;
absorptionEmissionModel constantAbsorptionEmission;
constantAbsorptionEmissionCoeffs
{
    absorptivity    absorptivity    [0 -1 0 0 0 0 0] $alphaEff;
    emissivity      emissivity      [0 -1 0 0 0 0 0] $alphaEff;
    E               E               [1 -1 -3 0 0 0 0] 0;
}
scatterModel    none;
sootModel       none;
transmissivityModel none;
