FoamFile { version 2.0; format ascii; class dictionary; object boundaryRadiationProperties; }
// Every surface is opaque diffuse-grey with eps 0.92 (walls, inlet plane incl. window, and both
// sides of the front and back faces). greyDiffusiveRadiation takes eps ONLY from here
// (greyDiffusiveRadiationMixedFvPatchScalarField.C:188), never from the ray-file entries.
".*"
{
    type            lookup;
    emissivity      0.92;
    absorptivity    0.92;
    transmissivity  0;
}
// Outlet: open to 300 K surroundings (paper 1's transparent outlet; paper 2 is silent).
// Black (eps 1) at Tamb = 300 K: the ray BC uses 'T Tamb' (field created by the coded function object
// 'Tamb' in system/auditFunctions).
// An exact name is matched before the ".*" pattern.
outlet
{
    type            lookup;
    emissivity      1;
    absorptivity    1;
    transmissivity  0;
}
