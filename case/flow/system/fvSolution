FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    "rho.*"         { solver diagonal; }
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-10;
        relTol          0.01;       // POLISH (last ~50 iterations): relTol 0; tolerance 1e-12;
    }
    "(U|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.05;
    }
}
SIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 0;
}
relaxationFactors
{
    fields          { rho 1; p_rgh 0.3; }
    equations       { U 0.7; h 1; }
}
